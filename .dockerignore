# Reinstalled inside the image; host copies carry host-specific native binaries.
node_modules
.yarn/install-state.gz
.yarn/cache
.yarn/unplugged

# Build output — the image builds its own.
.next
out
build
coverage
*.tsbuildinfo

# Not needed to build, and .git would bloat the build context.
.git
.gitignore
.github
.vscode
.claude
.DS_Store
README.md
Dockerfile
.dockerignore
docker-compose.yaml

# Secrets must never enter the build context.
.env*.local
*.pem

npm-debug.log*
yarn-debug.log*
yarn-error.log*
